{
  "version": 2,

  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",

  "functions": {
    "backend/api/index.py": {
      "runtime": "python3.11"
    }
  },

  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "^(?!/api/).*",
      "dest": "/index.html"
    }
  ]
}